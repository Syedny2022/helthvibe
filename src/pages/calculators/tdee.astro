---
import Layout from '@layouts/Layout.astro';
const title = 'Free TDEE Calculator — Total Daily Energy Expenditure | Helthvibe';
const description = 'Calculate your Total Daily Energy Expenditure (TDEE) — calories burned per day based on BMR and activity level.';
const softwareSchema = { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Helthvibe TDEE Calculator', applicationCategory: 'HealthApplication', operatingSystem: 'Web', url: 'https://helthvibe.com/calculators/tdee/', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } };
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [
  { '@type': 'Question', name: 'What is TDEE?', acceptedAnswer: { '@type': 'Answer', text: 'Total Daily Energy Expenditure is the total number of calories you burn in a day, including BMR plus activity. It is the foundation for setting calorie targets for weight loss, maintenance, or gain.' } },
  { '@type': 'Question', name: 'How do I choose the right activity factor?', acceptedAnswer: { '@type': 'Answer', text: 'Sedentary (1.2): desk job, no exercise. Light (1.375): light exercise 1–3 days/wk. Moderate (1.55): exercise 3–5 days/wk. Very active (1.725): exercise 6–7 days/wk. Extra active (1.9): athlete + physical job.' } },
  { '@type': 'Question', name: 'Is my data private?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. All math runs in your browser. We never see, store, or transmit your inputs.' } },
] };
const faqs = [
  { q: 'What is TDEE?', a: 'Total calories burned per day — BMR plus activity. The starting point for any calorie target.' },
  { q: 'Sedentary vs very active — which am I?', a: 'Sedentary = desk job, no structured exercise. Add 0.175 per level of activity. Most people overestimate by one level.' },
  { q: 'Should I eat at TDEE to maintain?', a: 'Yes. To lose weight, eat 300–500 kcal below TDEE. To gain, 300–500 above.' },
];
---
<Layout title={title} description={description} schema={[softwareSchema, faqSchema]}>
  <section class="page-hero">
    <div class="container">
      <span class="badge">Free · Mifflin-St Jeor · Private</span>
      <h1>TDEE Calculator</h1>
      <p class="lead">Total Daily Energy Expenditure — the calories you actually burn each day. Use this to set calorie targets for any goal.</p>
    </div>
  </section>
  <section class="section calc-section"><div class="container"><div class="calc-layout">
    <div class="calc-main"><div class="calc" data-tdee-calc id="tdee-main">
      <form class="form" data-form novalidate>
        <div class="row">
          <div class="field"><label class="field-label" for="tdee-h">Height (cm)</label><input type="number" id="tdee-h" name="h" min="100" max="250" step="0.1" placeholder="175" required /></div>
          <div class="field"><label class="field-label" for="tdee-w">Weight (kg)</label><input type="number" id="tdee-w" name="w" min="30" max="300" step="0.1" placeholder="70" required /></div>
        </div>
        <div class="row">
          <div class="field"><label class="field-label" for="tdee-age">Age</label><input type="number" id="tdee-age" name="age" min="18" max="100" step="1" placeholder="30" required /></div>
          <div class="field"><label class="field-label">Biological sex</label><div class="sex-toggle"><button type="button" class="sex-btn" data-sex="female">Female</button><button type="button" class="sex-btn active" data-sex="male">Male</button></div></div>
        </div>
        <div class="field">
          <label class="field-label">Activity level</label>
          <div class="activity-toggle">
            <button type="button" class="act-btn" data-act="sedentary">Sedentary</button>
            <button type="button" class="act-btn active" data-act="light">Light</button>
            <button type="button" class="act-btn" data-act="moderate">Moderate</button>
            <button type="button" class="act-btn" data-act="very_active">Very active</button>
            <button type="button" class="act-btn" data-act="extra_active">Extra active</button>
          </div>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Calculate TDEE</button>
        <p class="privacy-note">🔒 All math runs in your browser. Data never leaves this device.</p>
      </form>
      <div class="result" data-result hidden>
        <div class="result-score"><span class="result-label">Your total daily energy expenditure</span><span class="result-value" data-value>—</span><span class="result-unit">kcal/day</span></div>
        <p class="result-desc" data-desc></p>
        <div class="goal-grid">
          <div class="goal-card"><span class="goal-label">Lose (−500)</span><span class="goal-value" data-lose>—</span></div>
          <div class="goal-card"><span class="goal-label">Maintain</span><span class="goal-value" data-maintain>—</span></div>
          <div class="goal-card"><span class="goal-label">Gain (+500)</span><span class="goal-value" data-gain>—</span></div>
        </div>
      </div>
    </div></div>
    <aside class="calc-side">
      <div class="info-card"><h3>Activity factors</h3>
        <table class="cat-table"><tbody><tr><th>Level</th><th>Factor</th></tr><tr><td>Sedentary</td><td>1.2</td></tr><tr><td>Light</td><td>1.375</td></tr><tr><td>Moderate</td><td>1.55</td></tr><tr><td>Very active</td><td>1.725</td></tr><tr><td>Extra active</td><td>1.9</td></tr></tbody></table>
      </div>
      <div class="info-card"><h3>Setting calorie targets</h3><p>Eat at TDEE to maintain weight. Subtract 300–500 kcal to lose weight slowly and sustainably. Add 300–500 kcal to gain.</p></div>
      <div class="info-card"><h3>Privacy</h3><p>All calculations happen locally. Nothing is sent to a server.</p></div>
    </aside>
  </div></div></section>
  <section class="section section-soft"><div class="container-narrow"><h2>Frequently asked questions</h2><div class="faq-list">{faqs.map((f) => (<details class="faq-item"><summary>{f.q}</summary><p>{f.a}</p></details>))}</div></div></section>
  <section class="section"><div class="container"><h2>Keep exploring</h2><div class="grid grid-3"><a href="/calculators/bmr/" class="card"><h3 class="card-title">BMR</h3><p class="card-desc">Resting energy expenditure.</p></a><a href="/calculators/macro-split/" class="card"><h3 class="card-title">Macro Split</h3><p class="card-desc">Convert calorie target to grams.</p></a><a href="/calculators/calorie-deficit/" class="card"><h3 class="card-title">Calorie Deficit</h3><p class="card-desc">Plan a safe weight-loss deficit.</p></a></div></div></section>
</Layout>
<style>
  .page-hero { padding: var(--space-7) 0 var(--space-6); text-align: center; background: radial-gradient(ellipse at top, rgba(20, 184, 138, 0.08) 0%, transparent 60%), var(--color-bg); }
  .page-hero .badge { margin-bottom: var(--space-3); } .lead { font-size: 1.1rem; color: var(--color-text-soft); max-width: 640px; margin: 0 auto; }
  .calc-layout { display: grid; grid-template-columns: 1.4fr 1fr; gap: var(--space-6); align-items: start; }
  @media (max-width: 880px) { .calc-layout { grid-template-columns: 1fr; } }
  .calc-main { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: var(--space-6); box-shadow: var(--shadow-sm); }
  .calc-side { display: grid; gap: var(--space-4); }
  .info-card { background: var(--color-bg-soft); border: 1px solid var(--color-border-soft); border-radius: var(--radius-md); padding: var(--space-5); }
  .info-card h3 { font-size: 1rem; margin-bottom: var(--space-3); text-transform: uppercase; letter-spacing: 0.04em; }
  .cat-table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  .cat-table th, .cat-table td { padding: 0.5rem 0.6rem; text-align: left; border-bottom: 1px solid var(--color-border-soft); }
  .cat-table th { font-weight: 600; color: var(--color-text-muted); text-transform: uppercase; font-size: 0.78rem; letter-spacing: 0.04em; }
  .cat-table tr:last-child td { border-bottom: none; }
  .faq-list { display: grid; gap: var(--space-3); margin-top: var(--space-5); }
  .faq-item { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-4) var(--space-5); }
  .faq-item[open] { border-color: var(--color-brand); }
  .faq-item summary { cursor: pointer; font-weight: 600; color: var(--color-text); list-style: none; display: flex; justify-content: space-between; align-items: center; }
  .faq-item summary::after { content: '+'; font-size: 1.4rem; color: var(--color-brand); transition: transform 0.15s var(--ease-out); }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item p { margin: var(--space-3) 0 0; }
  .calc { display: grid; gap: var(--space-5); }
  .form { display: grid; gap: var(--space-4); }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); }
  .field { display: flex; flex-direction: column; gap: 0.4rem; }
  .field-label { font-size: 0.9rem; font-weight: 600; color: var(--color-text); }
  input[type="number"] { padding: 0.75rem 0.9rem; border: 1.5px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); width: 100%; }
  input[type="number"]:focus { outline: none; border-color: var(--color-brand); box-shadow: 0 0 0 3px rgba(20, 184, 138, 0.12); }
  .sex-toggle { display: grid; grid-template-columns: 1fr 1fr; background: var(--color-bg-soft); border-radius: var(--radius-md); padding: 4px; gap: 4px; }
  .sex-btn { padding: 0.6rem; font-size: 0.9rem; font-weight: 500; color: var(--color-text-soft); border-radius: var(--radius-sm); transition: all 0.15s var(--ease-out); }
  .sex-btn.active { background: var(--color-surface); color: var(--color-text); box-shadow: var(--shadow-sm); }
  .activity-toggle { display: grid; grid-template-columns: repeat(5, 1fr); background: var(--color-bg-soft); border-radius: var(--radius-md); padding: 4px; gap: 4px; }
  @media (max-width: 640px) { .activity-toggle { grid-template-columns: 1fr 1fr; } }
  .act-btn { padding: 0.5rem 0.4rem; font-size: 0.78rem; font-weight: 500; color: var(--color-text-soft); border-radius: var(--radius-sm); transition: all 0.15s var(--ease-out); }
  .act-btn.active { background: var(--color-surface); color: var(--color-text); box-shadow: var(--shadow-sm); }
  .privacy-note { margin: 0; text-align: center; font-size: 0.82rem; color: var(--color-text-muted); }
  .result { background: var(--color-bg-soft); border-radius: var(--radius-lg); padding: var(--space-6); display: grid; gap: var(--space-4); border: 1px solid var(--color-border-soft); animation: slideIn 0.3s var(--ease-out); }
  @keyframes slideIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
  .result-score { text-align: center; }
  .result-label { display: block; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-muted); margin-bottom: var(--space-2); }
  .result-value { display: inline-block; font-size: 3.5rem; font-weight: 800; color: var(--color-text); letter-spacing: -0.02em; }
  .result-unit { display: block; margin-top: var(--space-1); color: var(--color-text-muted); font-size: 0.9rem; }
  .result-desc { margin: 0; text-align: center; color: var(--color-text-soft); font-size: 0.95rem; }
  .goal-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: var(--space-3); margin-top: var(--space-3); }
  @media (max-width: 480px) { .goal-grid { grid-template-columns: 1fr; } }
  .goal-card { background: var(--color-surface); border: 1px solid var(--color-border-soft); border-radius: var(--radius-md); padding: var(--space-4); text-align: center; }
  .goal-label { display: block; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-muted); margin-bottom: var(--space-2); }
  .goal-value { font-size: 1.5rem; font-weight: 700; color: var(--color-text); }
</style>
<script>
  import { calculateBMR, calculateTDEE, ACTIVITY_FACTORS, type Sex, type ActivityLevel } from '@lib/health';
  function init(root: HTMLElement) {
    const form = root.querySelector('[data-form]') as HTMLFormElement;
    const result = root.querySelector('[data-result]') as HTMLElement;
    const valueEl = root.querySelector('[data-value]') as HTMLElement;
    const desc = root.querySelector('[data-desc]') as HTMLElement;
    const lose = root.querySelector('[data-lose]') as HTMLElement;
    const maintain = root.querySelector('[data-maintain]') as HTMLElement;
    const gain = root.querySelector('[data-gain]') as HTMLElement;
    let sex: Sex = 'male';
    let activity: ActivityLevel = 'light';
    root.querySelectorAll<HTMLButtonElement>('.sex-btn').forEach((b) => {
      b.addEventListener('click', () => {
        sex = b.dataset.sex as Sex;
        root.querySelectorAll('.sex-btn').forEach((x) => x.classList.toggle('active', (x as HTMLElement).dataset.sex === sex));
      });
    });
    root.querySelectorAll<HTMLButtonElement>('.act-btn').forEach((b) => {
      b.addEventListener('click', () => {
        activity = b.dataset.act as ActivityLevel;
        root.querySelectorAll('.act-btn').forEach((x) => x.classList.toggle('active', (x as HTMLElement).dataset.act === activity));
      });
    });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(form);
      const h = Number(d.get('h'));
      const w = Number(d.get('w'));
      const age = Number(d.get('age'));
      if (!h || !w || !age || h < 100 || age < 18) return;
      const bmr = calculateBMR({ heightCm: h, weightKg: w, age, sex });
      const tdee = calculateTDEE({ bmr, activity });
      const desc2 = ACTIVITY_FACTORS[activity];
      valueEl.textContent = tdee.toLocaleString();
      desc.textContent = `${desc2.label} (factor ${desc2.factor}): ${desc2.description}`;
      lose.textContent = `${(tdee - 500).toLocaleString()} kcal`;
      maintain.textContent = `${tdee.toLocaleString()} kcal`;
      gain.textContent = `${(tdee + 500).toLocaleString()} kcal`;
      result.hidden = false;
    });
  }
  document.querySelectorAll<HTMLElement>('[data-tdee-calc]').forEach(init);
</script>
