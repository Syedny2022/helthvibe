# ============================================================
# Helthvibe — environment template
# Copy to .env for local development. Never commit real values.
# ============================================================

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Leave empty to ship with zero analytics scripts and no consent banner.
# Set it in Cloudflare Pages -> Settings -> Environment variables to enable.
PUBLIC_GA_ID=

# Cloudflare API token (dash.cloudflare.com -> Profile -> API Tokens).
# Needs: Account -> Cloudflare Pages: Edit, Zone -> DNS: Edit, Zone -> Zone: Read.
# Local tooling only — used by `npm run cf:status` and `npm run cf:dns`.
CLOUDFLARE_API_TOKEN=

# Cloudflare account id (printed by `npm run cf:status`).
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare zone id for helthvibe.com (printed by `npm run cf:status`).
CLOUDFLARE_ZONE_ID=
