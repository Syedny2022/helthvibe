{
  "name": "helthvibe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Helthvibe — free, privacy-first health calculator suite.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "smoke": "node bmi-smoke.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name helthvibe --branch main",
    "deploy:preview": "npm run build && wrangler pages deploy dist --project-name helthvibe --branch preview",
    "og:generate": "node scripts/generate-og.mjs",
    "links:check": "node scripts/check-links.mjs",
    "cf:status": "node scripts/cf-status.mjs",
    "cf:setup": "node scripts/setup-cloudflare.mjs",
    "cf:dns": "node scripts/cf-setup-dns.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
    "@fontsource-variable/inter": "^5.2.5",
    "astro": "^5.1.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^5.7.2",
    "wrangler": "^4.59.2"
  }
}
